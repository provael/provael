cff-version: 1.2.0
message: "If you use Provael or its Embodied AI Security Top 10, please cite them as below."
title: Provael
abstract: >-
  Provael is an open-source, model-agnostic tool to red-team open Vision-Language-Action (VLA)
  robot policies in simulation and report an Attack Success Rate (ASR).
type: software
authors:
  - family-names: Jain
    given-names: Sattyam
    website: "https://github.com/sattyamjjain"
# Tracks the newest *released* tag, not the working tree — a citation must name a version a
# reader can actually install. Bump BOTH fields in the release commit: the 0.25.0 commit bumped
# `version` and left `date-released` on 0.22.0's date (2026-07-23), which is why a citation to
# 0.25.0 named a date three days before the artifact existed. `version` is guarded by
# tests/test_version_consistency.py; the date is not machine-checkable against a tag, so it is on
# the release author.
version: "0.29.0"
date-released: "2026-07-30"
license: Apache-2.0
repository-code: "https://github.com/provael/provael"
url: "https://github.com/provael/provael"
keywords:
  - vla
  - robotics
  - red-team
  - security
  - adversarial
  - ai-safety
references:
  - type: generic
    title: "The Embodied AI Security Top 10"
    version: "0.2"
    year: 2026
    authors:
      - family-names: Jain
        given-names: Sattyam
    url: "https://github.com/provael/provael/blob/main/docs/TOP10.md"
    license: CC-BY-SA-4.0
